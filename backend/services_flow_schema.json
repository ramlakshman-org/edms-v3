              "id": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "image": {
                "type": "string"
              }
            }
          },
          "__example__": [
            {
              "id": "whatsapp",
              "title": "WhatsApp",
              "description": "WhatsApp broadcast"
            },
            {
              "id": "audio",
              "title": "Audio SMS",
              "description": "Voice call broadcast"
            },
            {
              "id": "sms",
              "title": "SMS Broadcast",
              "description": "Text SMS broadcast"
            }
          ]
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
