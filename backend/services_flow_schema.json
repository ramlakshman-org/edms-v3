            "scale-type": "cover",
            "alt-text": "Social Media Request",
            "visible": "${data.has_banner}"
          },
          {
            "type": "TextBody",
            "text": "Choose a channel for your broadcast request."
          },
          {
            "type": "RadioButtonsGroup",
